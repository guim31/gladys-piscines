{
  "manifest_version": 1,
  "type": "device",
  "name": "Piscines en temps réel",
  "description": {
    "en": "Live crowd and opening of the public swimming pools of French cities (open data): Strasbourg…",
    "fr": "Affluence et ouverture en direct des piscines municipales de villes françaises : Strasbourg…",
    "de": "Live-Andrang und Öffnung städtischer Schwimmbäder in Frankreich (Open Data): Straßburg, Bordeaux",
    "es": "Afluencia y apertura en directo de piscinas municipales francesas (datos abiertos): Estrasburgo…"
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-piscines:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-piscines/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "countries": ["FR"],
  "keywords": [
    "piscine",
    "swimming pool",
    "Strasbourg",
    "Bordeaux",
    "affluence",
    "fréquentation",
    "open data"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Tick your cities and save: their pools appear in the Discover tab. Add the ones you want to Gladys. No account, no key.",
        "fr": "Cochez vos villes et enregistrez : leurs piscines apparaissent dans l'onglet Découverte. Ajoutez celles qui vous intéressent à Gladys. Sans compte ni clé.",
        "de": "Kreuze deine Städte an und speichere: ihre Schwimmbäder erscheinen im Tab „Entdecken“. Füge die gewünschten zu Gladys hinzu. Kein Konto, kein Schlüssel.",
        "es": "Marque sus ciudades y guarde: sus piscinas aparecen en la pestaña Descubrir. Añada a Gladys las que le interesen. Sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-piscines/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "cities",
      "type": "multi_select",
      "label": {
        "en": "Cities",
        "fr": "Villes",
        "de": "Städte",
        "es": "Ciudades"
      },
      "description": {
        "en": "Pools whose crowd is published live in open data. Others: see the guide.",
        "fr": "Piscines dont l'affluence est publiée en direct en open data. Autres villes : voir le guide.",
        "de": "Schwimmbäder, deren Andrang live als Open Data veröffentlicht wird. Andere Städte: siehe Anleitung.",
        "es": "Piscinas cuya afluencia se publica en directo en datos abiertos. Otras ciudades: vea la guía."
      },
      "options": [
        {
          "value": "strasbourg",
          "label": {
            "en": "Strasbourg (Eurométropole)",
            "fr": "Strasbourg (Eurométropole)",
            "de": "Straßburg (Eurométropole)",
            "es": "Estrasburgo (Eurométropole)"
          }
        },
        {
          "value": "bordeaux",
          "label": {
            "en": "Bordeaux (city pools)",
            "fr": "Bordeaux (piscines de la ville)",
            "de": "Bordeaux (städtische Bäder)",
            "es": "Burdeos (piscinas municipales)"
